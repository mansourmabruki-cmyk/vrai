name: Build Desktop (Windows + Linux)

# Construit le logiciel de bureau UNAMDD dans le cloud GitHub.
# Produit un installateur Windows (.exe) et une AppImage Linux,
# téléchargeables comme « artifacts ». Aucune installation locale requise.

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Install
        run: npm install
      - name: Build Windows
        run: npm run dist:win
      - name: Upload Windows
        uses: actions/upload-artifact@v4
        with:
          name: UNAMDD-logiciel-Windows
          path: dist/*.exe

  linux:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Install
        run: npm install
      - name: Build Linux
        run: npm run dist:linux
      - name: Upload Linux
        uses: actions/upload-artifact@v4
        with:
          name: UNAMDD-logiciel-Linux
          path: dist/*.AppImage

