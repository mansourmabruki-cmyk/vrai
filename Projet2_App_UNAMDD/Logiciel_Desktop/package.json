{
  "name": "unamdd-logiciel",
  "version": "1.0.0",
  "description": "UNAMDD Mining Sarl – logiciel de bureau (Windows / Linux) du Bureau technique",
  "author": "UNAMDD Mining Sarl",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder -wl"
  },
  "devDependencies": {
    "electron": "31.3.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "cd.unamdd.logiciel",
    "productName": "UNAMDD Mining Sarl",
    "files": [ "main.js", "app/**/*" ],
    "win": {
      "target": [ "nsis", "portable" ],
      "icon": "app/assets/icon512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "UNAMDD Mining Sarl"
    },
    "linux": {
      "target": [ "AppImage" ],
      "icon": "app/assets/icon512.png",
      "category": "Office"
    }
  }
}
